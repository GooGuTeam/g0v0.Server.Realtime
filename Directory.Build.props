<Project>

    <PropertyGroup>
        <!-- Enforce code style rules during build -->
        <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>

        <!-- Enable .NET analyzers -->
        <EnableNETAnalyzers>true</EnableNETAnalyzers>

        <!-- Pinned to the .NET 9 rule set. The .NET 10 SDK's `10.0-recommended` set adds CA1873 (logging argument
             evaluation), which fires on every `logger.LogX(..., expensiveArgument)` call site in this codebase.
             Raise this back to `latest-recommended` once those call sites guard their arguments. -->
        <AnalysisLevel>9.0-recommended</AnalysisLevel>

        <!-- Treat analyzer warnings as errors in CI (controlled by CI env variable) -->
        <CodeAnalysisTreatWarningsAsErrors>false</CodeAnalysisTreatWarningsAsErrors>

        <!-- Gate on warnings, but only for the projects in this repository. GitHub Actions exports
             CI=true, and this file is what maps it: g0v0.Server.Common is a sibling checkout with
             its own Directory.Build.props, so it never inherits this and its warnings cannot fail
             this repository's CI. Reproduce the gate locally with `CI=true dotnet build`.
             NU190x (NuGet audit) stays a warning: the vulnerable SixLabors.ImageSharp comes in
             transitively through g0v0.osu.Game and cannot be upgraded from here. -->
        <TreatWarningsAsErrors Condition="'$(CI)' == 'true'">true</TreatWarningsAsErrors>
        <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>

        <!-- Generate documentation XML -->
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
    </PropertyGroup>

    <ItemGroup>
        <!-- StyleCop.Analyzers for consistent code style -->
        <PackageReference Include="StyleCop.Analyzers" Version="1.2.0-beta.556">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>

        <!-- Meziantou.Analyzer for additional .NET best practices -->
        <PackageReference Include="Meziantou.Analyzer" Version="2.0.187">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>

        <!-- Roslynator for code analysis and refactoring -->
        <PackageReference Include="Roslynator.Analyzers" Version="4.12.11">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <AdditionalFiles Include="$(MSBuildThisFileDirectory)stylecop.json" Link="stylecop.json"/>
    </ItemGroup>

    <ItemGroup>
        <!-- AutoMapper 13.0.1 reaches us transitively via g0v0.osu.Game / ppy.osu.Game, which still pin that version
             at their latest release, and AutoMapper 15+ is commercially licensed so it cannot simply be force-upgraded.
             Suppress only this one advisory (CVE-2026-32933 / GHSA-rvv3-g6hj-g44x, DoS via uncontrolled recursion);
             every other transitive package stays audited. -->
        <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-rvv3-g6hj-g44x"/>
    </ItemGroup>

</Project>

